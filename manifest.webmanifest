{
  "name": "PoolDrive",
  "short_name": "PoolDrive",
  "description": "All your free Google Drive accounts as one drive",
  "id": "/PoolDrive/",
  "start_url": "/PoolDrive/",
  "scope": "/PoolDrive/",
  "display": "standalone",
  "background_color": "#111115",
  "theme_color": "#4f46e5",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/PoolDrive/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "files", "accept": ["*/*"] }]
    }
  }
}
